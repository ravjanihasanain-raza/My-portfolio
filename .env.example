# Copy this file to .env and edit.

# Where your backend lives.
# Dev:  leave it as /api and set VITE_PROXY_TARGET below (no CORS issues).
# Prod: use the full URL, e.g. https://api.yoursite.com/api
VITE_API_URL=/api

# Dev only: the address your backend runs on.
VITE_PROXY_TARGET=http://localhost:5000

# Set to false to skip the backend and show the sample content in src/data/content.js
VITE_USE_BACKEND=false
